# RepoRiddle Backend Environment Variables
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Optional: GitHub personal access token for higher rate limits (60 req/hr unauthenticated vs 5,000 req/hr authenticated)
GITHUB_TOKEN=

# Gemini API Key for grounded mission generation & evaluation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase / PostgreSQL Database URL (e.g. postgresql://postgres:password@db.xxx.supabase.co:5432/postgres)
# Falls back to in-memory/sqlite store if not provided.
DATABASE_URL=
